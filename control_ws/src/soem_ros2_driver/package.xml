<?xml version="1.0"?>
<package format="3">
  <name>soem_ros2_driver</name>
  <version>0.1.0</version>
  <description>
    🔧 基于 SOEM 的 EtherCAT + ROS2 驱动框架。
    支持多轴控制（CSP 模式），包含状态机、PDO 映射、日志与封装接口。
  </description>

  <!-- 作者与维护者信息 -->
  <maintainer email="hmj@example.com">HMJ</maintainer>
  <license>MIT</license>

  <!-- 构建工具 -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 运行时依赖 -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>

  <!-- 可选扩展依赖（后续加入时启用） -->
  <!-- <depend>sensor_msgs</depend> -->
  <!-- <depend>control_msgs</depend> -->

  <!-- 编译导出 -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
